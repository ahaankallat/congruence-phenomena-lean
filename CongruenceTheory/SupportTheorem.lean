import Mathlib
import CongruenceTheory.StrongWeighted
import CongruenceTheory.ContentBounds

/-!
**Proposition `prop:support`**: for a permutation-native weighted-permutation enumerator
`AwPerm w n`, if `n` is not in the numerical semigroup `Γ(w)` generated by `supp(w)` (treating
fixed points as length-`1` parts, so `1 ∈ Γ(w)`'s generators only when `w 1 ≠ 0`), then
`AwPerm w n = 0`. In particular, writing `d = ι(w)` for the least index with `w d ≠ 0`,
`AwPerm w n = 0` for `1 ≤ n < d` and `AwPerm w d = (d-1)! · w d`.
-/

namespace CongruenceTheory

open Equiv Equiv.Perm MvPolynomial

/-- `Γ(w)`, the numerical semigroup generated by `supp(w)`: `n ∈ Γ(w)` iff `n` is a sum of
parts, each with nonzero weight (fixed points count as parts of size `1`). -/
def Gamma (w : ℕ → ℤ) : Set ℕ :=
  {n | ∃ m : Multiset ℕ, (∀ x ∈ m, 1 ≤ x ∧ w x ≠ 0) ∧ m.sum = n}

/-- `eval w` of the cycle-indicator monomial for `a` fixed points and cycle-length multiset `m`
is `w 1 ^ a * (m.map w).prod`. -/
lemma eval_ciExp_monomial (w : ℕ → ℤ) (a : ℕ) (m : Multiset ℕ) :
    MvPolynomial.eval w (MvPolynomial.monomial (ciExp a m) (1 : ℤ)) =
      w 1 ^ a * (m.map w).prod := by
  rw [← pow_mul_multisetProd_eq_monomial]
  simp only [map_mul, map_pow, MvPolynomial.eval_X]
  congr 1
  induction m using Multiset.induction with
  | empty => simp
  | cons x s ih => simp [Multiset.map_cons, Multiset.prod_cons, ih]

/-- `eval w (ci g) = w 1 ^ (fixed points of g) * ∏_{ℓ ∈ cycleType g} w ℓ`. -/
lemma eval_ci (w : ℕ → ℤ) {α : Type*} [Fintype α] [DecidableEq α] (g : Equiv.Perm α) :
    MvPolynomial.eval w (ci g) =
      w 1 ^ (Fintype.card α - g.cycleType.sum) * (g.cycleType.map w).prod := by
  rw [ci_eq_monomial', eval_ciExp_monomial]

/-- **Proposition `prop:support`**, main clause: if `n ∉ Γ(w)`, then `AwPerm w n = 0`. -/
theorem AwPerm_eq_zero_of_not_mem_Gamma (w : ℕ → ℤ) (n : ℕ) (hn : n ∉ Gamma w) :
    AwPerm w n = 0 := by
  rw [AwPerm, Cperm, map_sum]
  apply Finset.sum_eq_zero
  intro g _
  rw [eval_ci, Fintype.card_fin]
  by_contra hne
  apply hn
  have hfix1 : w 1 ^ (n - g.cycleType.sum) ≠ 0 := by
    intro h0; apply hne; rw [h0]; ring
  have hprodne : (g.cycleType.map w).prod ≠ 0 := by
    intro h0; apply hne; rw [h0]; ring
  have hfixw1 : n - g.cycleType.sum = 0 ∨ w 1 ≠ 0 := by
    rcases Nat.eq_zero_or_pos (n - g.cycleType.sum) with h | h
    · exact Or.inl h
    · exact Or.inr (fun h1 => hfix1 (by rw [h1]; exact zero_pow h.ne'))
  have hallw : ∀ ℓ ∈ g.cycleType, w ℓ ≠ 0 := by
    intro ℓ hℓ h0
    apply hprodne
    apply Multiset.prod_eq_zero
    exact Multiset.mem_map.mpr ⟨ℓ, hℓ, h0⟩
  refine ⟨Multiset.replicate (n - g.cycleType.sum) 1 + g.cycleType, ?_, ?_⟩
  · intro x hx
    rw [Multiset.mem_add] at hx
    rcases hx with hx | hx
    · rw [Multiset.eq_of_mem_replicate hx]
      refine ⟨le_refl 1, ?_⟩
      rcases hfixw1 with h0 | h1
      · rw [h0] at hx; simp at hx
      · exact h1
    · have h2 := Equiv.Perm.two_le_of_mem_cycleType hx
      exact ⟨by omega, hallw x hx⟩
  · rw [Multiset.sum_add, Multiset.sum_replicate, smul_eq_mul, mul_one]
    have hle : g.cycleType.sum ≤ n := by
      have := Equiv.Perm.sum_cycleType_le g
      simpa using this
    omega

/-- **Proposition `prop:support`, "in particular" clause (first half)**: if `d` is the least
index with `w d ≠ 0`, then `AwPerm w n = 0` for every `1 ≤ n < d`. -/
theorem AwPerm_eq_zero_below_min_support (w : ℕ → ℤ) (d : ℕ) (hmin : ∀ j, 1 ≤ j → j < d → w j = 0)
    (n : ℕ) (hn1 : 1 ≤ n) (hnd : n < d) : AwPerm w n = 0 := by
  apply AwPerm_eq_zero_of_not_mem_Gamma
  rintro ⟨m, hm, hsum⟩
  have hall : ∀ x ∈ m, d ≤ x := by
    intro x hx
    obtain ⟨hx1, hxw⟩ := hm x hx
    by_contra hlt
    push Not at hlt
    exact hxw (hmin x hx1 hlt)
  rcases Multiset.empty_or_exists_mem m with hm0 | ⟨x0, hx0⟩
  · rw [hm0] at hsum; simp at hsum; omega
  · have hdle := hall x0 hx0
    have hxsum : m.sum = x0 + (m.erase x0).sum := by
      conv_lhs => rw [← Multiset.cons_erase hx0]
      rw [Multiset.sum_cons]
    omega

end CongruenceTheory
